-- Self-contained screenplay for Boba Fett world boss
-- One-at-a-time spawn, clean despawn, 4-hour respawn-after-death
-- Adds a 220m leash + snap-back to prevent long-chase crashes

BobaFettWanderScreenplay = ScreenPlay:new {
    numberOfActs = 1
}

local KEY_BOSS_ID  = "BobaFettWanderScreenplay:bossId"
local LEASH_RADIUS = 220        -- meters from spawn
local TICK_MS      = 10 * 1000  -- check every 10 seconds

-- get ground Z safely (some forks want planet,x,y; others x,y)
local function getGroundZ(planet, x, y)
    local ok, z = pcall(getTerrainHeight, planet, x, y)
    if ok and type(z) == "number" then return z end
    ok, z = pcall(getTerrainHeight, x, y)
    if ok and type(z) == "number" then return z end
    return 0
end

local function dist2d(x1, y1, x2, y2)
    local dx, dy = x1 - x2, y1 - y2
    return math.sqrt(dx*dx + dy*dy)
end

-- Safely clear combat + hate, compatible with most forks
local function clearBossCombat(pBoss)
    if pBoss == nil then return end
    local co = CreatureObject(pBoss)
    if co ~= nil then
        pcall(function() co:clearCombatState() end)
        pcall(function() co:resetPosture() end)
        -- optional: keep clean when snapping back
        pcall(function() co:removeAllBuffs() end)
        -- force "passive until attacked"
        pcall(function() co:setPvpStatusBitmask(ATTACKABLE) end)
    end
    -- Some forks expose AiAgent helpers; these pcall’s are safe if missing
    pcall(function() AiAgent(pBoss):clearCombatState() end)
    pcall(function() AiAgent(pBoss):clearHateList() end)
end

function BobaFettWanderScreenplay:start()
    if not isZoneEnabled("tatooine") then
        return
    end
    self:ensureSingleBoss()
end

function BobaFettWanderScreenplay:ensureSingleBoss()
    local existingId = readData(KEY_BOSS_ID)
    if existingId and existingId ~= 0 then
        local pExisting = getSceneObject(existingId)
        if pExisting ~= nil then
            -- boss alive; ensure watchdog is ticking
            createEvent(TICK_MS, "BobaFettWanderScreenplay", "tickBoss", nil, "")
            return
        else
            deleteData(KEY_BOSS_ID)
        end
    end
    self:spawnBobaFettBoss()
end

--True here tells the server to load this screenplay at server load. False tells it to wait until explicitly started.

deathBounty = ScreenPlay:new {
	screenplayName = deathBounty,
}

registerScreenPlay("deathBounty", true)
-- ===== AUTO-ADDED STUB (to prevent nil start() on load) =====
-- If the screenplay table doesn't exist, create a minimal one.
if (not deathBounty) then deathBounty = ScreenPlay:new { numberOfActs = 0 } end
-- If start() is missing, provide a no-op.
if (not deathBounty.start) then
  function deathBounty:start()
    return true -- no-op
  end
end
-- ===== /AUTO-ADDED STUB =====
